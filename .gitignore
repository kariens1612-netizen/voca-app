# Track only the Voca application.
/*
!/.gitignore
!/README.md
!/homedir/
/homedir/*
!/homedir/apps/
/homedir/apps/*
!/homedir/apps/voca/

# Local dependencies, credentials, data and generated files.
**/node_modules/
**/vendor/
.env
.env.*
!.env.example
!.env.mobile.example
**/auth.json
**/*.log
**/*.sql
**/*.sql.gz
**/*.sqlite
**/*.sqlite3
**/*.db
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore
**/.DS_Store
**/.phpunit*
**/.idea/
**/.vscode/
**/.gradle/
**/Pods/
**/DerivedData/
**/local.properties
**/hot
**/build/
**/storage/
**/bootstrap/cache/*
!**/bootstrap/cache/.gitignore
**/.well-known/
**/sw.js
**/workbox-*.js
# Custom Voca shop theme.
!homedir/apps/voca/vendor/
homedir/apps/voca/vendor/*
!homedir/apps/voca/vendor/shop/
homedir/apps/voca/vendor/shop/*
!homedir/apps/voca/vendor/shop/themes/
homedir/apps/voca/vendor/shop/themes/*
!homedir/apps/voca/vendor/shop/themes/voca/
